---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../../styles/menu-catalog.css";
import SiteLayout from "../../layouts/SiteLayout.astro";
import CafeNav from "../content/CafeNav.astro";
import MenuHeading from "../content/MenuHeading.astro";
import SignatureDishes from "../content/SignatureDishes.astro";
import ArrowIcon from "../site/ArrowIcon.astro";
import { loadPage } from "../../lib/content/load-page";
import { localizedMenu, localizedExtras } from "../../lib/i18n/menu";
import { translator, type Locale } from "../../lib/i18n/locale";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const menuCatalog = localizedMenu(locale);
const otherSections = menuCatalog.filter(
  (section) => section.id !== "signature",
);
const sandwichExtras = localizedExtras(locale);
const page = await loadPage();
const photos = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/food-menu/*.jpg",
  { eager: true },
);
const photo = (number: number) =>
  photos[`../../assets/food-menu/page-${String(number).padStart(2, "0")}.jpg`]
    .default;
const menuSchema = {
  "@context": "https://schema.org",
  "@type": "Menu",
  name: t("เมนูอาหาร A Cup of Zoo", "A Cup of Zoo food menu"),
  inLanguage: locale,
  hasMenuSection: menuCatalog.map((section) => ({
    "@type": "MenuSection",
    name: section.title,
    hasMenuItem: section.items.map((item) => ({
      "@type": "MenuItem",
      name: item.name,
      description: item.note,
      offers: item.variants
        ? item.variants.map((variant) => ({
            "@type": "Offer",
            name: variant.label,
            price: variant.price,
            priceCurrency: "THB",
          }))
        : { "@type": "Offer", price: item.price, priceCurrency: "THB" },
    })),
  })),
};
---

<SiteLayout
  locale={locale}
  title={t(
    "เมนูอาหารและราคา คาเฟ่ คลอง 6",
    "Food menu & prices · Khlong 6 café",
  )}
  description={t(
    "เลือกอาหาร 47 รายการที่ A Cup of Zoo คลอง 6 ปทุมธานี ทั้งจานซิกเนเจอร์ แซนวิช สเต็ก สปาเก็ตตี้ ข้าว และเมนูจากพืช พร้อมราคาและตัวเลือกเพิ่มไส้",
    "Browse 47 food dishes at A Cup of Zoo in Khlong 6, Pathum Thani: signature dishes, sandwiches, steaks, spaghetti, rice and plant-based options, with prices and add-ons.",
  )}
  page={page}
>
  <CafeNav locale={locale} />
  <MenuHeading locale={locale} book="food" />
  <SignatureDishes locale={locale} />
  <nav
    class="menu-jump"
    id="menu-categories"
    aria-label={t("หมวดเมนู", "Menu categories")}
  >
    {menuCatalog.map((section) => (
      <a href={`#${section.id}`}>{section.title}</a>
    ))}
  </nav>
  <div class="food-catalog">
    {otherSections.map((section) => (
      <section
        class="food-section"
        id={section.id}
        aria-labelledby={`${section.id}-title`}
      >
        <header class="food-section__heading">
          <h2 id={`${section.id}-title`}>{section.title}</h2>
          <p>{section.lede}</p>
        </header>
        <div class="food-section__body">
          <div>
            <ul class="food-list" role="list">
              {section.items.map((item) => (
                <li
                  data-menu-code={item.code}
                  id={`dish-${item.code.toLowerCase()}`}
                >
                  <div class="food-list__title">
                    <h3>
                      <span class="dish-code">{item.code}</span> {item.name}
                    </h3>
                    {!item.variants && (
                      <span class="dish-price">
                        {item.price}
                        {t(" บาท", " THB")}
                      </span>
                    )}
                  </div>
                  <p>{item.note}</p>
                  {item.variants && (
                    <dl class="price-options">
                      {item.variants.map((variant) => (
                        <div>
                          <dt>{variant.label}</dt>
                          <dd>
                            {variant.price}
                            {t(" บาท", " THB")}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  )}
                </li>
              ))}
            </ul>
            {section.id === "sandwiches" && (
              <div class="sandwich-extras">
                {sandwichExtras.map((group) => (
                  <section>
                    <h3>{group.title}</h3>
                    <dl class="price-options">
                      {group.items.map((item) => (
                        <div>
                          <dt>{item.name}</dt>
                          <dd>
                            +{item.price}
                            {t(" บาท", " THB")}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </section>
                ))}
              </div>
            )}
          </div>
          <div class="food-section__photos">
            <Image
              src={photo(section.imagePages[0])}
              alt={section.imageAlt}
              widths={[320, 560]}
              sizes="(max-width: 700px) 90vw, 34vw"
              format="webp"
              loading="lazy"
            />
            {section.imagePages.length > 1 && (
              <div class="food-gallery">
                {section.imagePages.slice(1).map((number) => (
                  <Image
                    src={photo(number)}
                    alt={t(
                      `ภาพเมนู${section.title}จากร้าน`,
                      `${section.title} from the café's menu`,
                    )}
                    width={560}
                    format="webp"
                    loading="lazy"
                  />
                ))}
              </div>
            )}
          </div>
        </div>
        <a class="catalog-back" href="#menu-categories">
          {t("กลับไปเลือกหมวด", "Back to menu categories")}{" "}
          <ArrowIcon direction="up" />
        </a>
      </section>
    ))}
  </div>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(menuSchema).replace(/</g, "\\u003c")}
  />
</SiteLayout>
