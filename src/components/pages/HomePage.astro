---
import { Image } from "astro:assets";
import ArrowIcon from "../site/ArrowIcon.astro";
import "../../styles/cafe-home.css";
import SiteLayout from "../../layouts/SiteLayout.astro";
import ContentUnavailable from "../content/ContentUnavailable.astro";
import NewsCard from "../content/NewsCard.astro";
import HomeIntroduction from "../home/HomeIntroduction.astro";
import HomeStories from "../home/HomeStories.astro";
import WatercolorAnimal from "../site/WatercolorAnimal.astro";
import WishingCorner from "../site/WishingCorner.astro";
import HeroVideo from "../site/HeroVideo.astro";
import ShopMap from "../site/ShopMap.astro";
import OpeningHours from "../site/OpeningHours.astro";
import SocialLinks from "../site/SocialLinks.astro";
import AnimalPartyMap from "../site/AnimalPartyMap.astro";
import ActivityAdmission from "../site/ActivityAdmission.astro";
import ActivityPhotoDialog from "../site/ActivityPhotoDialog.astro";
import crownedFox from "../../assets/club/crowned-fox.png";
import membershipCard from "../../assets/club/membership-card.png";
import { loadPage } from "../../lib/content/load-page";
import { allowedExternalUrl } from "../../lib/business/links";
import { translator, localePath, type Locale } from "../../lib/i18n/locale";
import { localizedVenue } from "../../lib/i18n/venue";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const href = (path: string) => localePath(path, locale);
const heroPosterSrc = "/videos/homepage-hero-poster.webp";
const mobileHero = {
  media: "(width <= 700px)",
  posterSrc: "/videos/homepage-hero-mobile-poster.webp",
  videoSrc: "/videos/homepage-hero-mobile-dissolve.mp4",
};
const page = await loadPage({ includePosts: locale === "th" });
const content = localizedVenue(page.venue, locale)?.content;
const hashtags = [
  "#Petcafe",
  "#Acupofzoo",
  t("#คาเฟ่สัตว์คลองหก", "#Khlong6AnimalCafe"),
  t("#คาเฟ่สัตว์รังสิต", "#RangsitAnimalCafe"),
  "#Petfriendly",
];
const maps = allowedExternalUrl(content?.mapsUrl ?? null, "maps");
const news = locale === "th" ? page.posts.slice(0, 2) : [];
---

<SiteLayout
  locale={locale}
  title={t(
    "คาเฟ่สัตว์ คลอง 6 ปทุมธานี",
    "Animal café in Khlong 6, Pathum Thani",
  )}
  description={t(
    "A Cup of Zoo คาเฟ่สัตว์และสวน คลอง 6 ปทุมธานี จิบเครื่องดื่ม พบเพื่อนสัตว์ เดินเล่นในสวนญี่ปุ่น พร้อมเมนู แพ็กเกจและข้อมูลก่อนมาเที่ยว",
    "A café, a garden and a few new friends. Discover A Cup of Zoo in Khlong 6, Pathum Thani, with food, animal experiences and everything you need to plan your visit.",
  )}
  page={page}
  includeJsonLd
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroPosterSrc}
    media="(width > 700px)"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={mobileHero.posterSrc}
    media={mobileHero.media}
    fetchpriority="high"
  />
  <section class="garden-hero page-bleed" aria-labelledby="home-title">
    <HeroVideo
      locale={locale}
      videoSrc="/videos/homepage-hero-dissolve.mp4"
      posterSrc={heroPosterSrc}
      mobile={mobileHero}
    />
    <p class="hero-place">
      A CUP OF ZOO <span>CAFÉ & RESTAURANT · KHLONG 6 · PATHUM THANI</span>
    </p>
    <div class="hero-copy">
      <p class="hero-eyebrow">
        {t(
          "อิ่มอร่อย เพลิดเพลินกับสวนญี่ปุ่นและเพื่อนสัตว์กว่า 20 ชนิด",
          "Enjoy good food, a Japanese garden and more than 20 kinds of animals",
        )}
      </p>
      <h1 id="home-title">
        {t("วันนี้กินอะไรดี…", "What’s good to eat today?")}
        <br />
        <span>{t("มีเพื่อนรออยู่", "Friends are waiting")}</span>
      </h1>
      <p class="hero-lede">
        {t(
          "ร้านอาหารและคาเฟ่ สัตว์เลี้ยงฮีลใจ",
          "A restaurant and café with animals to brighten your day.",
        )}
        <br />
        {t(
          "ชวนมาใช้เวลาด้วยกันทั้งวัน ที่คลอง 6 ปทุมธานี",
          "Spend the day with us in Khlong 6, Pathum Thani.",
        )}
      </p>
      <div class="hero-actions" data-hero-actions>
        <a class="hero-action" href={href("/visit/")}>
          {t("วางแผนมาเที่ยว", "Plan your visit")} <ArrowIcon />
        </a>
        <a class="hero-explore" href="#experiences">
          {t("สำรวจประสบการณ์", "Explore experiences")}{" "}
          <ArrowIcon direction="down" />
        </a>
      </div>
    </div>
    <div class="hero-foot">
      <p class="hero-hashtags">
        {hashtags.map((hashtag) => (
          <span>{hashtag}</span>
        ))}
      </p>
      <a
        href="#experiences"
        aria-label={t("เลื่อนลงเพื่อสำรวจร้าน", "Scroll to explore the café")}
      >
        <ArrowIcon direction="down" />
      </a>
    </div>
  </section>
  {page.venueProblem && (
    <ContentUnavailable
      detail={
        page.venueProblem === "missing"
          ? t(
              "ยังไม่ได้เผยแพร่ข้อมูลร้าน",
              "Café information has not been published yet.",
            )
          : undefined
      }
    />
  )}

  <HomeIntroduction locale={locale} />

  <ShopMap locale={locale} home />
  <ActivityAdmission locale={locale} home />
  <AnimalPartyMap locale={locale} venue={page.venue} home />

  <section class="club-invitation" aria-labelledby="home-club-title">
    <Image
      src={crownedFox}
      class="club-invitation__mascot"
      alt=""
      widths={[112, 192, 288]}
      sizes="(max-width: 700px) 64px, 144px"
      format="webp"
    />
    <div class="club-invitation__copy">
      <p class="club-invitation__name">
        Zoo Clubs
        <Image
          src={membershipCard}
          class="club-invitation__card"
          alt=""
          widths={[56, 112]}
          sizes="56px"
          format="webp"
        />
      </p>
      <h2 id="home-club-title">
        {t("ยิ่งมา ยิ่งสนิท", "Make yourself a regular")}
      </h2>
      <p>
        {t(
          "สมัครสมาชิกฟรีผ่าน LINE สะสมแต้มทุกบิล แล้วค่อย ๆ ขยับจาก Friend ไปเป็น Family ของน้อง ๆ",
          "Join free on LINE, collect points with every bill and grow from Friend to Family.",
        )}
      </p>
    </div>
    <div class="club-invitation__benefits">
      <div class="club-invitation__facts">
        <p>
          <strong>{t("รับ 5 แต้ม", "5 welcome points")}</strong>
          {t("เมื่อสมัครสมาชิก", "When you join")}
        </p>
        <p>
          <strong>{t("25 บาท = 1 แต้ม", "25 THB = 1 point")}</strong>
          {t("ทุกบิล รวมแพ็กเกจ", "Every bill, including passes")}
        </p>
      </div>
      <a class="button" href={href("/club/")}>
        {t("รู้จัก Zoo Clubs และสมัครฟรี", "Explore Zoo Clubs & join free")}{" "}
        <ArrowIcon />
      </a>
    </div>
  </section>

  <HomeStories locale={locale} />
  <WishingCorner locale={locale} />
  <section class="owner-section" aria-labelledby="home-events-title">
    <h2 id="home-events-title">
      {t("ทัวร์กลุ่ม & ร่วมงาน", "Group visits & collaborations")}
    </h2>
    <p>
      {t(
        "พาคณะมาเจอเพื่อนสัตว์ ชวนเราร่วมแคมเปญ หรือมาจัดอีเวนต์ที่ร้าน",
        "Bring your group to meet our animals, involve us in your next campaign, or host an event at the café.",
      )}
    </p>
    <div class="actions">
      <a class="button" href={href("/events/#group-visits")}>
        {t("ทัศนศึกษาและเยี่ยมชมเป็นกลุ่ม", "School & group visits")}{" "}
        <ArrowIcon />
      </a>
      <a class="button secondary" href={href("/events/#collaborations")}>
        {t("ร่วมงานกับแบรนด์", "Brand collaborations")} <ArrowIcon />
      </a>
    </div>
  </section>

  <section class="home-follow" aria-labelledby="follow-title">
    <div class="home-follow-copy">
      <WatercolorAnimal animal="ducks" />
      <p class="chapter-label">{t("เจอกันได้ทุกวัน", "Between visits")}</p>
      <h2 id="follow-title">{t("เป็นเพื่อนกันต่อ", "Let's stay in touch.")}</h2>
      <p>
        {t(
          "แวะดูความซนของน้อง ๆ ภาพจากสวน และข่าวจากร้าน แม้วันที่ยังไม่ได้แวะมา",
          "Little moments with the animals, a look around the garden and news from the café — even when you can't stop by.",
        )}
      </p>
    </div>
    <SocialLinks facebookUrl={content?.facebookUrl} />
  </section>

  {content && (
    <section class="visit-letter" aria-labelledby="visit-title">
      <div class="letter-heading">
        <p class="chapter-label">
          {t("จากหน้าจอ มาเจอกันที่ร้าน", "From your screen to our garden")}
        </p>
        <h2 id="visit-title">{t("แล้วแวะมานะ", "See you in the garden.")}</h2>
        <p>
          A Cup of Zoo
          <br />
          {content.locationLabel}
        </p>
        <p>{content.addressLine}</p>
        <div class="letter-actions">
          {maps && (
            <a class="button" href={maps}>
              {t("เปิดแผนที่มาร้าน", "Open the café map")} <ArrowIcon />
            </a>
          )}
          <a class="cafe-link" href={href("/visit/")}>
            {t("ข้อมูลก่อนมาเที่ยว", "Before your visit")} <ArrowIcon />
          </a>
        </div>
      </div>
      <div class="letter-details">
        <h3>{t("เวลาเจอกัน", "Opening hours")}</h3>
        <OpeningHours
          exceptions={content.hoursExceptions}
          entries={content.regularHours}
          holidayNote={content.holidayNote}
          locale={locale}
          compact
        />
      </div>
    </section>
  )}
  {locale === "th" && (news.length > 0 || page.postsProblem) && (
    <section class="cafe-news" aria-labelledby="news-title">
      <div class="news-heading">
        <h2 id="news-title">จดหมายจากร้าน</h2>
        <a class="cafe-link" href="/news/">
          อ่านทั้งหมด <ArrowIcon />
        </a>
      </div>
      {page.postsProblem && <ContentUnavailable />}
      {news.map((post) => (
        <NewsCard post={post} heading="h3" className="cafe-news-item" />
      ))}
    </section>
  )}
  <ActivityPhotoDialog locale={locale} />
</SiteLayout>
