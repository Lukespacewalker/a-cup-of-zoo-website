---
interface Props {
  direction?: "up-right" | "down-right" | "down" | "up";
}
const { direction = "up-right" } = Astro.props;
const rotation = { "up-right": -45, "down-right": 45, down: 90, up: -90 }[
  direction
];
---

<svg
  class="arrow-icon"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M5 12h14m-6-6 6 6-6 6" transform={`rotate(${rotation} 12 12)`} />
</svg>
<style>
  .arrow-icon {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    flex: none;
    vertical-align: -0.15em;
  }
</style>
