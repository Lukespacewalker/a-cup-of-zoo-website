---
interface Props {
  name: "facebook" | "instagram" | "tiktok" | "pin" | "phone";
}
const { name } = Astro.props;
---

<svg
  class="contact-icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "facebook" && (
    <path
      fill="currentColor"
      stroke="none"
      d="M14 22v-9h3l.5-3H14V8c0-.9.3-1.5 1.6-1.5H18V3.2c-.4-.1-1.8-.2-3.2-.2C11.7 3 10 4.8 10 8v2H7v3h3v9z"
    />
  )}
  {name === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r=".9" fill="currentColor" stroke="none" />
    </>
  )}
  {name === "tiktok" && (
    <path d="M14 3h3c.4 2.5 1.9 4 4 4.4v3.1a9 9 0 0 1-4-1.3v7a5.6 5.6 0 1 1-5-5.6v3.1a2.5 2.5 0 1 0 2 2.5z" />
  )}
  {name === "pin" && (
    <>
      <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
      <circle cx="12" cy="10" r="2.5" />
    </>
  )}
  {name === "phone" && (
    <path d="m8 3 2 5-2.5 2a14 14 0 0 0 6.5 6.5l2-2.5 5 2v3a2 2 0 0 1-2 2A18 18 0 0 1 3 5a2 2 0 0 1 2-2Z" />
  )}
</svg>
