---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<svg
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "cup" && (
    <path d="M4 8h12v7a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5ZM16 9h2a3 3 0 0 1 0 6h-2M7 3v2m4-2v2" />
  )}
  {name === "paw" && (
    <>
      <ellipse cx="6" cy="8" rx="2" ry="3" transform="rotate(-25 6 8)" />
      <ellipse cx="11" cy="5" rx="2" ry="3" />
      <ellipse cx="17" cy="7" rx="2" ry="3" transform="rotate(25 17 7)" />
      <path d="M6 17c0-3 4-7 6-7s6 4 6 7-3 3-6 2-6 1-6-2Z" />
    </>
  )}
  {name === "tree" && (
    <path d="M12 21v-7m-5 7h10M8 15a5 5 0 0 1-2-9 6 6 0 0 1 12 0 5 5 0 0 1-2 9Z" />
  )}
  {name === "wish" && (
    <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9Z" />
  )}
  {name === "flower" && (
    <>
      <path d="M12 9c-6-9-12 0-3 3-9 6 0 12 3 3 6 9 12 0 3-3 9-6 0-12-3-3Z" />
      <circle cx="12" cy="12" r="2" />
    </>
  )}
  {name === "cactus" && (
    <path d="M10 21V6a2 2 0 0 1 4 0v15M10 14H7a3 3 0 0 1-3-3V8m10 4h3a3 3 0 0 0 3-3V6M7 21h10" />
  )}
  {name === "fish" && (
    <>
      <path d="M3 12s4-6 9-6 7 6 7 6-2 6-7 6-9-6-9-6Zm16 0 3-4v8Zm-9-5 2 5-2 5" />
      <circle cx="7" cy="11" r=".6" fill="currentColor" />
    </>
  )}
  {name === "bridge" && (
    <path d="M3 18h18M4 18V6m16 12V6M4 8c4 6 12 6 16 0M8 12v6m4-5v5m4-6v6" />
  )}
  {name === "boat" && (
    <path d="m3 14 4 6h10l4-6Zm9 0V3l7 8h-7M2 22c2-2 3 2 5 0s3 2 5 0 3 2 5 0 3 2 5 0" />
  )}
  {name === "restroom" && (
    <>
      <circle cx="8" cy="5" r="2" />
      <path d="M5 10h6v6H9v5H7v-5H5Zm10-7v18m4-11h2m-1-2v4" />
    </>
  )}
  {name === "parking" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="4" />
      <path d="M9 17V7h4a3 3 0 0 1 0 6H9" />
    </>
  )}
  {name === "zoom" && (
    <>
      <circle cx="10" cy="10" r="6" />
      <path d="m15 15 6 6M7 10h6m-3-3v6" />
    </>
  )}
  {name === "close" && <path d="m6 6 12 12M6 18 18 6" />}
</svg>
