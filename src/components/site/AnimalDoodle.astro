  {animal === "cat" && <>
    <path d="M19 63c-4-17 2-33 17-38l3-16 14 11c7-1 12 0 18 3L84 12l1 22c7 10 8 25 1 34-8 11-34 16-52 10-9-3-13-8-15-15Z" />
