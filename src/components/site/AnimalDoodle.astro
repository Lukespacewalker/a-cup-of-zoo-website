    <path d="M18 64c0-17 14-30 33-30 20 0 34 13 34 30 0 16-12 25-34 25-21 0-33-9-33-25Z" />
    <path d="M33 58c3-3 7-3 10 0m18 0c3-3 7-3 10 0m-22 9 4 2 4-2m-4 2c-1 4-4 6-7 4m7-4c1 4 4 6 7 4M31 69l-17-3m18 8-16 3m56-8 15-3m-15 8 16 3M28 84l-3 8m48-8 3 8" />
  </>}
</svg>
