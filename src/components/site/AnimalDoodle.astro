    <path d="M31 76c-3 10 5 17 14 15m30-16c5 9-1 16-12 16m23-23c12 2 12 18 1 20" />
  </>}
  {animal === "duck" && <>
    <path d="M17 62c-1-13 11-24 28-24 5-10 4-20 13-25 12-6 24 2 24 15 0 7-4 13-9 17 1 6-1 14-6 19-12 12-38 15-50-2Z" />
    <path d="M82 32c8-2 15 1 16 5-2 5-11 8-20 6M61 27h.5M25 54c7 1 11 6 16 10 6 4 12 4 18 0M19 62c-8 1-12 5-13 10m35 4-3 10m19-10 3 10m-28 1h12m10 0h13" />
