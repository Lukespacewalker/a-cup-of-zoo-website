---
import { translator, type Locale } from "../../lib/i18n/locale";
interface Props {
  locale: Locale;
  videoSrc: string;
  posterSrc: string;
  mobile: { media: string; videoSrc: string; posterSrc: string };
}
const { locale, videoSrc, posterSrc, mobile } = Astro.props;
const t = translator(locale);
---

<div class="hero-media" data-hero-media>
  <div class="hero-media__scene" aria-hidden="true">
    <picture>
      <source
        media={mobile.media}
        srcset={mobile.posterSrc}
        width="540"
        height="960"
      />
      <img
        data-hero-poster
        src={posterSrc}
        alt=""
        width="960"
        height="540"
        fetchpriority="high"
      />
    </picture>
    <video
      data-hero-video
      muted
      loop
      playsinline
      preload="none"
      width="1920"
      height="1080"
      tabindex="-1"
    >
      <source src={mobile.videoSrc} media={mobile.media} type="video/mp4" />
      <source src={videoSrc} type="video/mp4" />
    </video>
  </div>
  <button
    hidden
    type="button"
    class="hero-media__toggle"
    data-hero-toggle
    data-play-label={t("เล่นวิดีโอ", "Play video")}
    data-pause-label={t("หยุดวิดีโอชั่วคราว", "Pause video")}
    aria-label={t("เล่นวิดีโอ", "Play video")}
  >
    <span data-play-icon aria-hidden="true">
      ▷
    </span>
    <span data-pause-icon aria-hidden="true" hidden>
      Ⅱ
    </span>
  </button>
</div>
<script>
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-hero-media]",
  )) {
    const poster = root.querySelector<HTMLImageElement>("[data-hero-poster]");
    const video = root.querySelector<HTMLVideoElement>("[data-hero-video]");
    const button = root.querySelector<HTMLButtonElement>("[data-hero-toggle]");
    if (!poster || !video || !button) continue;
    const playIcon = button.querySelector<HTMLElement>("[data-play-icon]")!;
    const pauseIcon = button.querySelector<HTMLElement>("[data-pause-icon]")!;
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let failed = false;
    let wantsPlayback = false;
    let allowAutoplay = !motion.matches;
    const sync = () => {
      const playing = !video.paused && !video.ended;
      button.setAttribute(
        "aria-label",
        (playing ? button.dataset.pauseLabel : button.dataset.playLabel)!,
      );
      playIcon.hidden = playing;
      pauseIcon.hidden = !playing;
    };
    const stop = () => {
      wantsPlayback = false;
      video.pause();
      sync();
    };
    const play = async () => {
      if (failed) return;
      wantsPlayback = true;
      try {
        await video.play();
        if (!wantsPlayback) video.pause();
      } catch {
        wantsPlayback = false;
        video.pause();
      }
      sync();
    };
    video.muted = true;
    button.hidden = false;
    button.addEventListener("click", () => {
      allowAutoplay = false;
      if (video.paused) void play();
      else stop();
    });
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    video.addEventListener("ended", sync);
    video.addEventListener("playing", () => {
      root.dataset.ready = "true";
    });
    const fail = () => {
      failed = true;
      stop();
      root.dataset.ready = "false";
      button.hidden = true;
    };
    video.addEventListener("error", fail);
    // The browser can try the desktop source when the mobile source fails.
    video.querySelector("source:last-of-type")?.addEventListener("error", fail);
    motion.addEventListener("change", () => {
      if (!motion.matches) return;
      allowAutoplay = false;
      stop();
    });
    if (allowAutoplay) {
      const pageLoaded =
        document.readyState === "complete"
          ? Promise.resolve()
          : new Promise<void>((resolve) => {
              window.addEventListener("load", () => resolve(), { once: true });
            });
      void Promise.all([pageLoaded, poster.decode().catch(() => {})]).then(
        () => {
          // Leave a frame for the decoded poster to paint before requesting video.
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              if (allowAutoplay) void play();
            });
          });
        },
      );
    }
  }
</script>
