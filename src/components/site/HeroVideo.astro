---
import { translator, type Locale } from "../../lib/i18n/locale";
interface Props {
  locale: Locale;
  videoSrc: string;
  posterSrc: string;
  mobile: { media: string; videoSrc: string; posterSrc: string };
}
const { locale, videoSrc, posterSrc, mobile } = Astro.props;
const t = translator(locale);
---

<div class="hero-media" data-hero-media>
  <div class="hero-media__scene" aria-hidden="true">
    <picture>
      <source
        media={mobile.media}
        srcset={mobile.posterSrc}
        width="540"
        height="960"
      />
      <img
        data-hero-poster
        src={posterSrc}
        alt=""
        width="960"
        height="540"
        fetchpriority="high"
      />
    </picture>
    <video
      data-hero-video
      muted
      loop
      playsinline
      preload="none"
      width="1920"
      height="1080"
      tabindex="-1"
    >
      <source src={mobile.videoSrc} media={mobile.media} type="video/mp4" />
      <source src={videoSrc} type="video/mp4" />
    </video>
  </div>
  <button
    hidden
    type="button"
    class="hero-media__toggle"
    data-hero-toggle
    data-play-label={t("เล่นวิดีโอ", "Play video")}
    data-pause-label={t("หยุดวิดีโอชั่วคราว", "Pause video")}
    aria-label={t("เล่นวิดีโอ", "Play video")}
  >
    <span data-play-icon aria-hidden="true">
      ▷
    </span>
    <span data-pause-icon aria-hidden="true" hidden>
      Ⅱ
    </span>
  </button>
</div>
<script>
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-hero-media]",
  )) {
    const poster = root.querySelector<HTMLImageElement>("[data-hero-poster]");
    const video = root.querySelector<HTMLVideoElement>("[data-hero-video]");
    const button = root.querySelector<HTMLButtonElement>("[data-hero-toggle]");
    const portrait = video?.querySelector<HTMLSourceElement>("source[media]");
    if (!poster || !video || !button || !portrait) continue;
    const playIcon = button.querySelector<HTMLElement>("[data-play-icon]")!;
    const pauseIcon = button.querySelector<HTMLElement>("[data-pause-icon]")!;
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const portraitViewport = window.matchMedia(portrait.media);
    let failed = false;
    let wantsPlayback = false;
    let allowAutoplay = !motion.matches;
    let playRequest = 0;
    let pendingPosition: number | undefined;
    let restoreFrame = false;
    let reselectOnPlay = false;
    const sync = () => {
      const playing = !video.paused && !video.ended;
      button.setAttribute(
        "aria-label",
        (playing ? button.dataset.pauseLabel : button.dataset.playLabel)!,
      );
      playIcon.hidden = playing;
      pauseIcon.hidden = !playing;
    };
    const stop = () => {
      wantsPlayback = false;
      playRequest += 1;
      video.pause();
      sync();
    };
    const play = async () => {
      if (failed) return;
      if (reselectOnPlay) {
        reselectOnPlay = false;
        video.load();
      }
      const request = ++playRequest;
      wantsPlayback = true;
      try {
        await video.play();
      } catch {
        if (request === playRequest) stop();
        return;
      }
      if (request === playRequest) sync();
    };
    video.muted = true;
    button.hidden = false;
    button.addEventListener("click", () => {
      allowAutoplay = false;
      if (video.paused) void play();
      else stop();
    });
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    video.addEventListener("ended", sync);
    const showFrame = () => {
      if (video.seeking || video.readyState < video.HAVE_CURRENT_DATA) return;
      pendingPosition = undefined;
      if (restoreFrame || wantsPlayback) root.dataset.ready = "true";
      restoreFrame = false;
    };
    video.addEventListener("playing", showFrame);
    video.addEventListener("loadeddata", showFrame);
    video.addEventListener("seeked", showFrame);
    const fail = () => {
      failed = true;
      pendingPosition = undefined;
      restoreFrame = false;
      stop();
      root.dataset.ready = "false";
      button.hidden = true;
    };
    video.addEventListener("error", fail);
    // The browser can try the desktop source when the mobile source fails.
    video.querySelector("source:last-of-type")?.addEventListener("error", fail);
    portraitViewport.addEventListener("change", () => {
      restoreFrame ||= root.dataset.ready === "true";
      failed = false;
      button.hidden = false;
      // Explicit load() can fetch media even with preload="none".
      if (!restoreFrame && !wantsPlayback) {
        reselectOnPlay = true;
        return;
      }
      const position = pendingPosition ?? video.currentTime;
      pendingPosition = position > 0 ? position : undefined;
      root.dataset.ready = "false";
      if (restoreFrame) video.preload = "auto";
      playRequest += 1;
      // Reselect the native sources, including the wide fallback.
      video.load();
      if (pendingPosition !== undefined) video.currentTime = pendingPosition;
      if (wantsPlayback) void play();
      else sync();
    });
    motion.addEventListener("change", () => {
      if (!motion.matches) return;
      allowAutoplay = false;
      stop();
    });
    if (allowAutoplay) {
      const pageLoaded =
        document.readyState === "complete"
          ? Promise.resolve()
          : new Promise<void>((resolve) => {
              window.addEventListener("load", () => resolve(), { once: true });
            });
      void Promise.all([pageLoaded, poster.decode().catch(() => {})]).then(
        () => {
          // Leave a frame for the decoded poster to paint before requesting video.
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              if (allowAutoplay) void play();
            });
          });
        },
      );
    }
  }
</script>
