---
import ShopLogo from "./ShopLogo.astro";
import ArrowIcon from "./ArrowIcon.astro";
import {
  localeFromPath,
  localePath,
  basePath,
  bilingualPaths,
  translator,
} from "../../lib/i18n/locale";
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const href = (path: string) => localePath(path, locale);
const links = [
  ["/cafe/", t("คาเฟ่", "Café")],
  ["/animals/", t("เพื่อนสัตว์", "Animal friends")],
  ["/activities/", t("กิจกรรม & แพ็กเกจ", "Activities & passes")],
  ["/news/", t("ข่าว", "News (Thai)")],
  ["/events/", t("ทัวร์กลุ่ม & ร่วมงาน", "Group tours & collaborations")],
  ["/club/", t("สมาชิก Zoo Clubs", "Zoo Clubs membership")],
  ["/visit/", t("เวลาทำการ/แผนที่", "Hours & directions")],
  ["/farm/", t("ฟาร์มของเรา", "Our farm")],
];
const currentPath = Astro.url.pathname;
const currentSection = (url: string) => {
  if (currentPath === url) return "page";
  if (currentPath.startsWith(url))
    return url === href("/cafe/") ? "true" : "page";
};
const counterpart = bilingualPaths.includes(basePath(currentPath));
const switchHref = localePath(
  counterpart ? currentPath : "/",
  locale === "th" ? "en" : "th",
);
const switchCode = locale === "en" ? "TH" : "EN";
const switchText = counterpart ? switchCode : `${switchCode} · Home`;
const switchLanguage = locale === "en" ? "Thai" : "English";
---

<header class="site-header">
  <a class="wordmark" href={href("/")}>
    <ShopLogo id="header-logo" />
  </a>
  <nav
    id="site-nav"
    class="site-nav"
    aria-label={t("หลัก", "Main navigation")}
    popover="auto"
  >
    {links.map(([path, label]) => (
      <a
        class:list={[{ "visit-link": path === "/visit/" }]}
        href={href(path)}
        aria-current={currentSection(href(path))}
      >
        {label}
        {path === "/visit/" && <ArrowIcon />}
      </a>
    ))}
  </nav>
  <div class="header-tools">
    <a
      class="language-switch"
      data-equivalent={counterpart ? "true" : "false"}
      href={switchHref}
      lang="en"
      aria-label={`${switchText} (${switchLanguage})`}
    >
      {switchText}
    </a>
    <button
      class="theme-button"
      type="button"
      hidden
      aria-label={t("โหมดสีตามเครื่อง", "System colour theme")}
    >
      <svg class="icon-auto" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12 3a9 9 0 1 0 0 18V3z" />
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z"
        />
      </svg>
      <svg class="icon-light" viewBox="0 0 24 24" aria-hidden="true">
        <circle
          cx="12"
          cy="12"
          r="4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
        />
        <path
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5 5l1.6 1.6M17.4 17.4 19 19M19 5l-1.6 1.6M6.6 17.4 5 19"
        />
      </svg>
      <svg class="icon-dark" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M15.5 3.2a8.2 8.2 0 1 0 5.3 12.6A7 7 0 0 1 15.5 3.2z"
        />
      </svg>
    </button>
    <button
      class="menu-button"
      type="button"
      aria-label={t("เมนู", "Open navigation")}
      aria-controls="site-nav"
      popovertarget="site-nav"
    >
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 6h16" />
        <path d="M4 12h16" />
        <path d="M4 18h16" />
      </svg>
    </button>
  </div>
</header>
<script>
  const english = document.documentElement.lang === "en";
  const languageSwitch = document.querySelector<HTMLAnchorElement>(
    '.language-switch[data-equivalent="true"]',
  );
  if (languageSwitch) {
    const updateHash = () => {
      languageSwitch.hash = location.hash;
    };
    updateHash();
    window.addEventListener("hashchange", updateHash);
  }
  const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
  const nav = document.querySelector<HTMLElement>("#site-nav");
  if (menuButton && nav && "popover" in HTMLElement.prototype) {
    const compact = matchMedia("(max-width: 1050px)");
    const firstLink = nav.querySelector("a");
    const syncLayout = () => {
      const active = document.activeElement;
      nav.toggleAttribute("popover", compact.matches);
      if (compact.matches && nav.contains(active)) {
        menuButton.focus({ preventScroll: true });
      } else if (!compact.matches && active === menuButton) {
        firstLink?.focus({ preventScroll: true });
      } else if (
        !compact.matches &&
        active instanceof HTMLElement &&
        nav.contains(active)
      ) {
        active.focus({ preventScroll: true });
      }
    };
    syncLayout();
    compact.addEventListener("change", syncLayout);
    nav.dataset.enhanced = "";

    let closing = false;
    nav.addEventListener("beforetoggle", (event) => {
      const open = event.newState === "open";
      closing = !open;
      if (open) nav.classList.remove("focus-dismissed");
      if (english) {
        menuButton.setAttribute(
          "aria-label",
          open ? "Close navigation" : "Open navigation",
        );
      }
    });
    nav.addEventListener("toggle", (event) => {
      if (event.newState === "open") firstLink?.focus();
    });
    const dismiss = () => {
      nav.classList.add("focus-dismissed");
      nav.hidePopover();
    };
    document.addEventListener("focusin", (event) => {
      const next = event.target;
      if (
        !closing &&
        next !== menuButton &&
        !(next instanceof Node && nav.contains(next)) &&
        nav.matches(":popover-open")
      ) {
        dismiss();
      }
    });
    nav.addEventListener("keydown", (event) => {
      if (
        event.key === "Tab" &&
        event.shiftKey &&
        !event.ctrlKey &&
        !event.metaKey &&
        event.target === firstLink &&
        nav.matches(":popover-open")
      ) {
        event.preventDefault();
        dismiss();
        menuButton.focus({ preventScroll: true });
      }
    });
  }

  const themeButton =
    document.querySelector<HTMLButtonElement>(".theme-button");
  const colorScheme = document.querySelector<HTMLMetaElement>(
    'meta[name="color-scheme"]',
  );
  const order = ["auto", "light", "dark"] as const;
  type Theme = (typeof order)[number];
  const labels: Record<Theme, string> = english
    ? {
        auto: "System colour theme",
        light: "Light colour theme",
        dark: "Dark colour theme",
      }
    : { auto: "โหมดสีตามเครื่อง", light: "โหมดสว่าง", dark: "โหมดมืด" };
  const paintTheme = (theme: Theme) => {
    document.documentElement.dataset.theme = theme;
    if (colorScheme)
      colorScheme.content = theme === "auto" ? "light dark" : theme;
    themeButton?.setAttribute("aria-label", labels[theme]);
  };
  const parseTheme = (value: string | null | undefined): Theme =>
    value === "light" || value === "dark" ? value : "auto";
  paintTheme(parseTheme(document.documentElement.dataset.theme));
  if (themeButton) themeButton.hidden = false;
  themeButton?.addEventListener("click", () => {
    const current = parseTheme(document.documentElement.dataset.theme);
    const next = order[(order.indexOf(current) + 1) % order.length];
    paintTheme(next);
    try {
      if (next === "auto") localStorage.removeItem("cup-theme");
      else localStorage.setItem("cup-theme", next);
    } catch {
      // The current page still follows the selection when storage is blocked.
    }
  });
  window.addEventListener("storage", (event) => {
    if (
      event.storageArea === localStorage &&
      (event.key === "cup-theme" || event.key === null)
    ) {
      paintTheme(parseTheme(event.newValue));
    }
  });
</script>
