---
import type { ImageFocus, PublicVenueMedia } from "@lukespace-cms/client";
import Picture from "./Picture.astro";
import { localImages } from "../../lib/content/local-images";
import { portraitGeometry } from "../../lib/content/animal-portrait";

interface Props {
  mediaId: string | null;
  media: PublicVenueMedia[];
  alt: string;
  focus?: ImageFocus | null;
}
const { mediaId, media, alt, focus } = Astro.props;
const remote = media.find((item) => item.id === mediaId);
const local = mediaId
  ? localImages[mediaId as keyof typeof localImages]
  : undefined;
const source = local ?? remote;
const crop = portraitGeometry(
  source?.width ?? null,
  source?.height ?? null,
  focus,
);
---

<span
  class="animal-portrait"
  data-animal-portrait
  style={`--portrait-width:${crop.width}%;--portrait-height:${crop.height}%;--portrait-left:${crop.left}%;--portrait-top:${crop.top}%`}
>
  <Picture mediaId={mediaId} media={media} alt={alt} />
</span>

<style>
  .animal-portrait {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .animal-portrait :global(img) {
    position: absolute;
    width: var(--portrait-width);
    height: var(--portrait-height);
    max-width: none;
    left: var(--portrait-left);
    top: var(--portrait-top);
    object-fit: cover;
  }
</style>
