---
import { Image } from "astro:assets";
import foodCover from "../../assets/menu/food-cover.webp";
import drinksCover from "../../assets/menu/drinks-cover.webp";
import { menuBooks } from "../../lib/content/owner-brief";
import { translator, type Locale } from "../../lib/i18n/locale";
import ArrowIcon from "../site/ArrowIcon.astro";

interface Props {
  locale: Locale;
  book: keyof typeof menuBooks;
  compact?: boolean;
}

const { locale, book, compact = false } = Astro.props;
const t = translator(locale);
const food = book === "food";
const action = food
  ? t("เปิดเล่มเมนูอาหาร", "Open the food menu book")
  : t("เปิดเล่มเครื่องดื่มและขนม", "Open the drinks & desserts book");
---

<a
  class:list={["menu-book", { "menu-book--compact": compact }]}
  href={menuBooks[book]}
  target="_blank"
  rel="noopener"
>
  <Image
    src={food ? foodCover : drinksCover}
    alt=""
    widths={[120, 240, 400]}
    sizes={compact ? "64px" : "(max-width: 40rem) 80px, 144px"}
    format="webp"
    loading="lazy"
  />
  <span class="menu-book__body">
    <span class="menu-book__action">{action}</span>
    <span class="menu-book__hint">
      {t("Heyzine · เปิดแท็บใหม่", "Heyzine · Opens in a new tab")}
    </span>
  </span>
  <ArrowIcon />
</a>

<style>
  .menu-book {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.65rem, 2vw, 1.35rem);
    min-inline-size: 0;
    padding: clamp(0.8rem, 2.5vw, 1.35rem);
    color: var(--cocoa-deep);
    background: var(--paper);
    border: 1px solid var(--line);
    text-decoration: none;
  }
  .menu-book--compact {
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    padding: 0.75rem;
  }
  .menu-book:hover {
    background: var(--blush);
  }
  .menu-book img {
    width: 100%;
    height: auto;
  }
  .menu-book__body {
    display: grid;
    gap: 0.3rem;
  }
  .menu-book__action {
    font-weight: 700;
    line-height: 1.45;
  }
  .menu-book:hover .menu-book__action {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .menu-book__hint {
    color: var(--muted-text);
    font-size: 0.78rem;
  }
  @media (width <= 40rem) {
    .menu-book:not(.menu-book--compact) {
      grid-template-columns: 5rem minmax(0, 1fr) auto;
    }
  }
</style>
