---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import catRice from "../../assets/food-menu/signature-cat-rice.webp";
import dogRice from "../../assets/food-menu/signature-dog-rice.webp";
import parrotSalad from "../../assets/food-menu/signature-parrot-salad.webp";
import { localizedMenu } from "../../lib/i18n/menu";
import { translator, type Locale } from "../../lib/i18n/locale";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
const signature = localizedMenu(locale).find(
  (section) => section.id === "signature",
);
const signaturePhotos: Record<string, { src: ImageMetadata; alt: string }> = {
  SIG1: {
    src: catRice,
    alt: t(
      "ข้าวผัดสมุนไพรกับปลาทู มะนาว และพริก",
      "Herb fried rice with mackerel, lime and chillies",
    ),
  },
  SIG2: {
    src: dogRice,
    alt: t(
      "ข้าวผัดหมูผสมเส้น เสิร์ฟกับผักสดและมะนาว",
      "Pork fried rice with noodles, lettuce and lime",
    ),
  },
  SIG3: {
    src: parrotSalad,
    alt: t(
      "ยำตะไคร้กับกุ้งและผักสด",
      "Lemongrass salad with shrimp and fresh greens",
    ),
  },
};
---

{signature && (
  <section
    class="signature-menu"
    id="signature"
    aria-labelledby="signature-title"
  >
    <h2 id="signature-title">{signature.title}</h2>
    <ul class="signature-menu__dishes" role="list">
      {signature.items.map((item) => {
        const image = signaturePhotos[item.code];
        return (
          <li data-menu-code={item.code} id={`dish-${item.code.toLowerCase()}`}>
            <Image
              src={image.src}
              alt={image.alt}
              widths={[240, 400]}
              sizes="(max-width: 600px) calc(100vw - 4rem), (max-width: 1264px) 30vw, 360px"
              format="webp"
              loading="lazy"
            />
            <div class="signature-menu__dish-heading">
              <h3>{item.name}</h3>
              <span class="signature-menu__price">
                {item.price}
                {t(" บาท", " THB")}
              </span>
            </div>
            <p>{item.note}</p>
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .signature-menu,
  .signature-menu__dishes > li {
    scroll-margin-top: 8rem;
  }
  .signature-menu {
    margin-top: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 4vw, 2.625rem);
    background: light-dark(#30392c, #242c22);
    color: light-dark(#fff5e4, #f7ecda);
  }
  .signature-menu h2 {
    margin: 0 0 clamp(1rem, 2.8vw, 1.75rem);
    color: inherit;
    font-size: clamp(1.95rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.3;
  }
  .signature-menu__dishes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.625rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .signature-menu__dishes img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 5px;
  }
  .signature-menu__dish-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .signature-menu h3 {
    margin: 0;
    color: inherit;
    font-size: clamp(1.2rem, 2.4vw, 1.625rem);
    font-weight: 700;
    line-height: 1.4;
  }
  .signature-menu__price {
    color: light-dark(#f1cca1, #e9c49b);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .signature-menu p {
    margin: 0.3rem 0 0;
    color: light-dark(#dfd8c7, #d6cebd);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  @media (max-width: 600px) {
    .signature-menu__dishes {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .signature-menu__dishes img {
      aspect-ratio: 6 / 5;
    }
  }
</style>
