---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  photos: { src: ImageMetadata; alt: string }[];
  campaign?: boolean;
}
const { photos, campaign = false } = Astro.props;
---

<div class={campaign ? "event-gallery campaign-gallery" : "event-gallery"}>
  {photos.map((photo, index) => (
    <figure>
      <Image
        src={photo.src}
        alt={photo.alt}
        widths={[400, 700]}
        sizes={
          campaign || index > 0
            ? "(max-width: 700px) 45vw, 30vw"
            : "(max-width: 700px) 90vw, 30vw"
        }
        format="webp"
        loading="lazy"
      />
    </figure>
  ))}
</div>
