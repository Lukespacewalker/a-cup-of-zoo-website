---
import { translator, type Locale } from "../../lib/i18n/locale";
import MenuBook from "./MenuBook.astro";

interface Props {
  locale: Locale;
  book: "food" | "drinks";
}

const { locale, book } = Astro.props;
const t = translator(locale);
const food = book === "food";
---

<header class="menu-heading" id="menu-top">
  <div>
    <h1>
      {food ? t("เมนูอาหาร", "Food menu") : t("เมนูเครื่องดื่ม", "Drinks menu")}
    </h1>
    <p>
      {food
        ? t(
            "ดูจานซิกเนเจอร์ของร้าน หรือเลือกหมวดเพื่อดูรายการอาหารและราคา",
            "Start with our signature dishes, or choose a category to see dishes and prices.",
          )
        : t(
            "เลือกดูเครื่องดื่มพร้อมราคาแบบร้อน เย็น และปั่น",
            "Browse drinks and prices for hot, iced and blended options.",
          )}
    </p>
    {food && (
      <a class="catalog-back" href="#menu-categories">
        {t("เลือกหมวดอาหาร", "Browse food categories")}
      </a>
    )}
  </div>
  <MenuBook locale={locale} book={book} compact />
</header>

<style>
  .menu-heading {
    display: grid;
    gap: 1rem 2.5rem;
    padding-block: clamp(0.5rem, 2vw, 1.5rem);
  }
  .menu-heading h1 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.3;
    margin: 0;
  }
  .menu-heading p {
    color: var(--muted-text);
    margin: 0.5rem 0 0;
  }
  .catalog-back {
    margin-top: 0;
  }
  @media (width >= 64rem) {
    .menu-heading {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 20rem);
      align-items: start;
    }
  }
</style>
