---
import SiteLayout from "../layouts/SiteLayout.astro";
import Picture from "../components/content/Picture.astro";
import ContentUnavailable from "../components/content/ContentUnavailable.astro";
import { loadPage, isDemoPost, thaiTranslation } from "../lib/content/load-page";
import { allowedExternalUrl } from "../lib/business/links";
import { stickers } from "../lib/content/decor";

const page = await loadPage();
const venue = page.venue;
const content = venue?.content;
const maps = allowedExternalUrl(content?.mapsUrl ?? null, "maps");
const menu = content?.menuHighlights.filter((item) => item.visible).sort((a, b) => a.sortOrder - b.sortOrder) ?? [];
const news = page.posts.slice(0, 2);
---
<SiteLayout title="A Cup of Zoo" description="คาเฟ่สัตว์คลอง 6 สำหรับครอบครัว มาเจอน้องหมา น้องแมว และเพื่อนขนฟูอีกหลายตัว" page={page} includeJsonLd>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__image">{venue && <Picture eager mediaId="cafe-garden-seating" media={venue.media} alt="มุมนั่งริมสวนและโต๊ะไม้ในร้าน A Cup of Zoo" />}</div>
    <div class="home-hero__content">
      <p class="kicker">A Cup of Zoo · Cafe & Farm · คลอง 6</p>
      <h1 id="home-title">พักใจสักนิด<br /><em>แล้วพบเพื่อนตัวน้อย</em></h1>
      <p>พื้นที่ให้ทั้งบ้านใช้เวลาช้า ๆ ด้วยกัน ท่ามกลางสวน มุมคาเฟ่ และเพื่อนสัตว์ที่รอให้มาทักทาย</p>
      <div class="actions"><a class="button" href="/visit/">วางแผนมาเที่ยว <span aria-hidden="true">↗</span></a><a class="text-link" href="/animals/">รู้จักเพื่อนสัตว์ <span aria-hidden="true">→</span></a></div>
    </div>
    <span class="home-hero__index" aria-hidden="true">A little pause, a lot of joy.</span>
  </section>
  {page.venueProblem && <ContentUnavailable detail={page.venueProblem === "missing" ? "ยังไม่ได้เผยแพร่ข้อมูลร้าน" : undefined} />}
  <section class="intro-line" aria-label="บรรยากาศของร้าน"><span class="section-number">01 / THE PLACE</span><p>ความสุขเล็ก ๆ เริ่มจากการได้อยู่ด้วยกัน <span>แวะจิบเครื่องดื่ม เดินเล่นในสวน แล้วค่อย ๆ ทำความรู้จักเพื่อนใหม่</span></p><img class="intro-line__friend" src={stickers.fox.src} alt="" /></section>
  <section class="home-section animals-section" aria-labelledby="animals-title">
    <div class="section-heading"><div><p class="kicker">MEET OUR FRIENDS</p><h2 id="animals-title">เพื่อนสัตว์ที่อยากให้รู้จัก</h2></div><a class="text-link" href="/animals/">ดูเพื่อนทั้งหมด <span aria-hidden="true">→</span></a></div>
    <div class="animal-editorial">
      <article class="animal-photo animal-photo--large">{venue && <Picture mediaId="cat-portrait" media={venue.media} alt="แมวสีส้มของร้าน" />}<div><span>01</span><h3>เจ้าเหมียว</h3><p>เพื่อนขนฟูในมุมแสนอบอุ่น</p></div></article>
      <article class="animal-photo">{venue && <Picture mediaId="cats-and-dog" media={venue.media} alt="แมวและสุนัขของร้าน" />}<div><span>02</span><h3>น้องหมาและผองเพื่อน</h3><p>ช่วงเวลาที่ชวนยิ้มได้เสมอ</p></div></article>
      <article class="animal-photo">{venue && <Picture mediaId="ducks-pond" media={venue.media} alt="เป็ดในบ่อน้ำของร้าน" />}<div><span>03</span><h3>เพื่อนริมบ่อ</h3><p>อีกมุมให้แวะทักทาย</p></div></article>
    </div><p class="section-note">รายชื่อสัตว์อ้างอิงโพสต์ของเพจร้านวันที่ 9 ธันวาคม 2025 · ภาพถ่ายจากร้าน</p>
  </section>
  <section class="home-section taste-section" aria-labelledby="taste-title">
    <div class="section-heading"><div><p class="kicker">A MOMENT TO SAVOUR</p><h2 id="taste-title">เติมความอร่อยระหว่างวัน</h2></div><a class="text-link" href="/menu/">ดูเมนู <span aria-hidden="true">→</span></a></div>
    <p class="section-lede">พักที่โต๊ะตัวโปรดกับเครื่องดื่มและของหวานจากร้าน</p>
    <div class="taste-grid">{menu.slice(0, 2).map((item, index) => <article class="taste-card"><Picture mediaId={item.mediaAssetId} media={venue?.media ?? []} alt={item.title} /><div><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
  </section>
  <section class="home-section experience-section" aria-labelledby="experience-title"><div class="experience-copy"><p class="kicker">STAY A LITTLE LONGER</p><h2 id="experience-title">วันสบาย ๆ<br />ในมุมของเรา</h2><p>เลือกมุมที่ชอบ นั่งพักในคาเฟ่ หรือออกไปเดินเล่นในสวน แล้วค่อยแวะทักทายเพื่อนสัตว์ตามคำแนะนำของพนักงาน</p><a class="text-link" href="/activities/">สำรวจพื้นที่และกิจกรรม <span aria-hidden="true">→</span></a></div>{venue && <Picture mediaId="cafe-interior-gallery" media={venue.media} alt="มุมนั่งและของตกแต่งภายในร้าน A Cup of Zoo" />}</section>
  {content && <section class="home-section visit-section" aria-labelledby="visit-title"><div class="section-heading"><div><p class="kicker">COME FIND US</p><h2 id="visit-title">แล้วพบกันที่คลอง 6</h2></div></div><div class="visit-overview"><div><span>OPENING HOURS</span><strong>10:00–19:00</strong><p>ปิดวันอังคาร ยกเว้นวันหยุดนักขัตฤกษ์<br />ตามประกาศของเพจร้าน</p></div><div><span>LOCATION</span><strong>{content.locationLabel}</strong><p>ตรวจสอบข้อมูลการเดินทางก่อนออกจากบ้าน</p></div><div class="visit-overview__action"><a class="button" href="/visit/">ข้อมูลก่อนมาเที่ยว <span aria-hidden="true">↗</span></a>{maps && <a class="text-link" href={maps}>เปิดแผนที่ <span aria-hidden="true">↗</span></a>}</div></div></section>}
  {(news.length > 0 || page.postsProblem) && <section class="home-section news-section" aria-labelledby="news-title"><div class="section-heading"><div><p class="kicker">FROM THE CAFE</p><h2 id="news-title">เรื่องใหม่จากร้าน</h2></div><a class="text-link" href="/news/">ข่าวทั้งหมด <span aria-hidden="true">→</span></a></div>{page.postsProblem && <ContentUnavailable />}<div class="news-grid">{news.map((post) => { const translation = thaiTranslation(post); return <article class="news-item"><h3><a href={`/news/${translation.slug}/`}>{translation.title}</a></h3>{isDemoPost(post) && <span class="badge">ตัวอย่างระบบ</span>}<p>{translation.excerpt.replace("[[demo]]", "").trim()}</p></article>; })}</div></section>}
</SiteLayout>
