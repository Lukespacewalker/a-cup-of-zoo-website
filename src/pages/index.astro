---
import "../styles/cafe-home.css";
import SiteLayout from "../layouts/SiteLayout.astro";
import Picture from "../components/content/Picture.astro";
import ContentUnavailable from "../components/content/ContentUnavailable.astro";
import FoxSeal from "../components/site/FoxSeal.astro";
import { loadPage, isDemoPost, thaiTranslation } from "../lib/content/load-page";
import { allowedExternalUrl } from "../lib/business/links";

const page = await loadPage();
const venue = page.venue;
const content = venue?.content;
const media = venue?.media ?? [];
const maps = allowedExternalUrl(content?.mapsUrl ?? null, "maps");
const menu = content?.menuHighlights.filter((item) => item.visible).sort((a, b) => a.sortOrder - b.sortOrder) ?? [];
const news = page.posts.slice(0, 2);
---
<SiteLayout title="A Cup of Zoo" description="คาเฟ่สัตว์คลอง 6 สำหรับครอบครัว แวะจิบเครื่องดื่ม เดินเล่นในสวน และพบเพื่อนสัตว์ที่ A Cup of Zoo" page={page} includeJsonLd>
  <section class="cafe-cover" aria-labelledby="home-title">
    <div class="cover-title">
      <p class="cafe-address">A CUP OF ZOO <span aria-hidden="true">·</span> คาเฟ่และฟาร์ม คลอง 6</p>
      <h1 id="home-title">จิบอะไรดี… <span>มีเพื่อนรออยู่</span></h1>
      <svg class="cover-sprig" viewBox="0 0 90 110" fill="none" aria-hidden="true"><path d="M22 103C45 68 39 39 72 9M39 72C13 77 7 57 9 49C29 47 40 59 39 72ZM43 49C61 55 80 46 83 30C64 27 48 33 43 49ZM55 28C39 27 36 13 40 5C52 5 60 14 55 28Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </div>
    <div class="cover-photos">
      <figure class="cover-photo cover-photo--garden">
        <a href="/activities/" aria-label="เดินเล่นในสวนและมุมคาเฟ่"><Picture eager mediaId="cafe-garden-seating" media={media} alt="มุมนั่งริมสวนและผ้าม่านญี่ปุ่นในร้าน" /></a>
        <figcaption>มุมโปรดสักมุม <span aria-hidden="true">↗</span></figcaption>
      </figure>
      <figure class="cover-photo cover-photo--friends">
        <a href="/animals/" aria-label="รู้จักเพื่อนสัตว์ที่ A Cup of Zoo"><Picture eager mediaId="cats-and-dog" media={media} alt="แมวสองตัวอยู่ด้วยกันกับสุนัขของร้าน A Cup of Zoo" /></a>
        <figcaption><span class="handwritten">ยินดีต้อนรับเข้าบ้านของพวกเรา</span><span aria-hidden="true">♡</span></figcaption>
      </figure>
      <figure class="cover-photo cover-photo--drink">
        <a href="/menu/" aria-label="แวะดูเครื่องดื่มและขนม"><Picture eager mediaId="drinks" media={media} alt="เครื่องดื่มกับของหวานสีสดใสของร้าน" /></a>
        <figcaption>อะไรอร่อย ๆ สักแก้ว <span aria-hidden="true">↗</span></figcaption>
      </figure>
    </div>
    <div class="cover-bottom">
      <p>วันสบาย ๆ ในสวน<br /><span>กับกาแฟ ขนม และเพื่อนขนฟู</span></p>
      <a class="wander-link" href="#friends">เดินเล่นด้วยกัน <span aria-hidden="true">↓</span></a>
      <a class="cafe-link cover-visit" href="/visit/">แวะมาที่คลอง 6 <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  {page.venueProblem && <ContentUnavailable detail={page.venueProblem === "missing" ? "ยังไม่ได้เผยแพร่ข้อมูลร้าน" : undefined} />}

  <section class="friends-story" id="friends" aria-labelledby="friends-title">
    <div class="friends-copy">
      <p class="chapter-label">ทำความรู้จักกันก่อน</p>
      <h2 id="friends-title">วันนี้…<br />จะทักใครก่อนดี<span class="ink-dot">?</span></h2>
      <p>จากมุมของเจ้าเหมียวไปจนถึงริมบ่อ<br />มีเพื่อนให้ค่อย ๆ ทำความรู้จัก<br />ระหว่างเดินเล่นในร้าน</p>
      <a class="cafe-link" href="/animals/">รู้จักเพื่อนสัตว์ทั้งหมด <span aria-hidden="true">↗</span></a>
      <div class="fox-greeting" aria-hidden="true"><FoxSeal /><span>ค่อย ๆ เข้ามาทักกันนะ</span></div>
    </div>
    <figure class="friend-portrait">
      <a href="/animals/" aria-label="พบเจ้าเหมียวและเพื่อนสัตว์"><Picture mediaId="cat-portrait" media={media} alt="แมวสีส้มของร้านนั่งอยู่บนเก้าอี้" /></a>
      <figcaption><span class="handwritten">เจ้าเหมียว</span><span>มุมเล็ก ๆ ของเพื่อนขนฟู</span></figcaption>
    </figure>
    <figure class="pond-portrait">
      <a href="/animals/" aria-label="พบเพื่อนริมบ่อและสัตว์อื่น ๆ"><Picture mediaId="ducks-pond" media={media} alt="กลุ่มเป็ดกำลังว่ายในบ่อน้ำสีเขียวของร้าน" /></a>
      <figcaption><span class="handwritten">แก๊งริมบ่อ</span><span>เดินต่ออีกนิด ก็เจอกันแล้ว</span></figcaption>
    </figure>
  </section>

  <section class="cafe-table" aria-labelledby="table-title">
    <figure class="table-photo"><Picture mediaId="croissant" media={media} alt="ขนมอบพร้อมจิ้งจอกตกแต่งจากร้าน" /><figcaption>ความอร่อยอีกมุมของ A Cup of Zoo</figcaption></figure>
    <div class="table-copy">
      <p class="chapter-label">พักตรงนี้อีกหน่อย</p>
      <h2 id="table-title">มีของอร่อย<br /><span class="handwritten">รออยู่ที่โต๊ะ</span></h2>
      <p>สั่งเครื่องดื่มที่ชอบ แบ่งขนมกันสักชิ้น<br />แล้วปล่อยให้วันนี้ผ่านไปช้า ๆ</p>
      <div class="table-menu">{menu.slice(0, 2).map((item) => <a href="/menu/"><span>{item.title}</span><span aria-hidden="true">↗</span></a>)}</div>
      <a class="cafe-link" href="/menu/">เปิดดูเมนูของร้าน <span aria-hidden="true">↗</span></a>
    </div>
    <span class="table-note handwritten" aria-hidden="true">a little treat,<br />a little happiness.</span>
  </section>

  <section class="garden-story" aria-labelledby="garden-title">
    <div class="garden-heading"><p class="chapter-label">ที่ของวันไม่เร่งรีบ</p><h2 id="garden-title">นั่งเล่น เดินเล่น<br /><span class="handwritten">แล้วค่อยกลับก็ได้</span></h2></div>
    <figure class="garden-main"><Picture mediaId="cafe-interior-gallery" media={media} alt="มุมนั่งในร้านที่ตกแต่งด้วยภาพสัตว์และของสะสม" /><figcaption>ภาพวาด ของสะสม และมุมนั่งในร้าน</figcaption></figure>
    <div class="garden-aside"><figure><Picture mediaId="cafe-garden-seating" media={media} alt="โต๊ะริมหน้าต่างที่มองออกไปเห็นสวนสีเขียว" /><figcaption class="handwritten">เก็บมุมนี้ไว้ในวันพักผ่อน</figcaption></figure><p>เลือกมุมที่ชอบในคาเฟ่<br />หรือออกไปเดินเล่นในสวน<br />อยู่ด้วยกันให้เต็มอิ่มอีกนิด</p><a class="cafe-link" href="/activities/">พาเดินดูรอบร้าน <span aria-hidden="true">↗</span></a></div>
  </section>

  {content && <section class="visit-letter" aria-labelledby="visit-title">
    <div class="letter-heading"><p class="chapter-label">จากหน้าจอ…มาเจอกันที่ร้าน</p><h2 id="visit-title">แล้วแวะมานะ<span class="ink-dot">.</span></h2><p>A Cup of Zoo<br />{content.locationLabel}</p><FoxSeal class="letter-fox" /></div>
    <div class="letter-details"><div><h3>เวลาเจอกัน</h3><p class="letter-hours">10:00 — 19:00</p><p>ปิดวันอังคาร ยกเว้นวันหยุดนักขัตฤกษ์<br />ตรวจสอบประกาศร้านก่อนเดินทาง</p></div><div><h3>เดินทางมาหาเรา</h3><p>{content.addressLine}</p></div><div class="letter-actions">{maps && <a class="button" href={maps}>เปิดแผนที่มาร้าน <span aria-hidden="true">↗</span></a>}<a class="cafe-link" href="/visit/">ข้อมูลก่อนมาเที่ยว <span aria-hidden="true">↗</span></a></div></div>
  </section>}

  {(news.length > 0 || page.postsProblem) && <section class="cafe-news" aria-labelledby="news-title"><div class="news-heading"><h2 id="news-title">จดหมายจากร้าน</h2><a class="cafe-link" href="/news/">อ่านทั้งหมด <span aria-hidden="true">↗</span></a></div>{page.postsProblem && <ContentUnavailable />}<div>{news.map((post) => { const translation = thaiTranslation(post); return <article class="cafe-news-item"><h3><a href={`/news/${translation.slug}/`}>{translation.title}</a></h3>{isDemoPost(post) && <span class="badge">ตัวอย่างระบบ</span>}<p>{translation.excerpt.replace("[[demo]]", "").trim()}</p></article>; })}</div></section>}
</SiteLayout>
