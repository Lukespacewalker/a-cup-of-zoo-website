---
import "../styles/activities.css";
import SiteLayout from "../layouts/SiteLayout.astro";
import FoxSeal from "../components/site/FoxSeal.astro";
import Picture from "../components/content/Picture.astro";
import ContentUnavailable from "../components/content/ContentUnavailable.astro";
import { loadPage } from "../lib/content/load-page";
const page = await loadPage();
const items = page.venue?.content.activities.filter((item) => item.visible).sort((a, b) => a.sortOrder - b.sortOrder) ?? [];
---
<SiteLayout title="กิจกรรม" description="บรรยากาศและพื้นที่ของ A Cup of Zoo จากภาพร้าน" page={page}>
  <header class="page-intro">
    <FoxSeal class="page-intro__fox" />
    <p class="eyebrow">SPACE & MOMENTS</p>
    <h1>พื้นที่ให้ใช้เวลาด้วยกัน</h1>
    <p>เดินเล่น พักในคาเฟ่ และแวะชมเพื่อนสัตว์ตามมุมต่าง ๆ ของร้าน หากอยากทำกิจกรรมใกล้ชิดกับสัตว์ สอบถามพนักงานถึงรอบและเงื่อนไขก่อนนะ</p>
  </header>
  {page.venueProblem && <ContentUnavailable />}
  {items.length > 0 && <section class="spaces" aria-label="มุมต่าง ๆ ของร้าน">
    {items.map((item, index) => <article class="space-feature">
      <div class="space-feature__media"><Picture mediaId={item.mediaAssetId} media={page.venue?.media ?? []} eager={index === 0} /></div>
      <div class="space-feature__copy">
        <span class="space-feature__number" aria-hidden="true">{String(index + 1).padStart(2, "0")} / {String(items.length).padStart(2, "0")}</span>
        <h2>{item.title}</h2>
        <p>{item.description}</p>
      </div>
    </article>)}
  </section>}
  {page.venue && <section class="arrival" aria-labelledby="arrival-title">
    <div class="arrival__heading">
      <div><p class="chapter-label">เริ่มเดินเล่นจากตรงนี้</p><h2 id="arrival-title">มุมทางเข้า</h2></div>
      <p>บรรยากาศแรกที่ต้อนรับเมื่อมาถึง A Cup of Zoo</p>
    </div>
    <Picture mediaId="entrance-promo-banner" media={page.venue.media} />
  </section>}
</SiteLayout>
