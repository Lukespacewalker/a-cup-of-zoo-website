{
  "name": "a-cup-of-zoo-website",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "bun run scripts/prepare-assets.ts",
    "dev": "bun run prepare:assets && astro dev --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "format": "prettier --write src tests/unit",
    "format:check": "prettier --check src tests/unit",
    "test:unit": "bun test tests/unit",
    "test:e2e": "playwright test",
    "build": "bun run prepare:assets && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "deploy:preview": "bun run build && wrangler deploy",
    "verify:content": "bun run scripts/verify-content.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@fontsource/itim": "^5.3.0",
    "@fontsource/mali": "^5.3.0",
    "@fontsource/noto-sans-thai-looped": "^5.3.0",
    "@lukespace-cms/client": "file:../CMS-Platform-acupofzoo/packages/client",
    "astro": "7.3.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.56.1",
    "@types/three": "0.186.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.139.0"
  }
}
