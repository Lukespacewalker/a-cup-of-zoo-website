    "@lukespace-cms/client": "file:../CMS-Platform-acupofzoo/packages/client",
    "astro": "7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.56.1",
    "typescript": "^5.9.3"
  }
