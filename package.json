{
  "name": "a-cup-of-zoo-website",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "bun run scripts/prepare-assets.ts",
    "dev": "bun run prepare:assets && astro dev --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "test:unit": "bun test tests/unit",
    "test:e2e": "playwright test",
