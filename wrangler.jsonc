{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "a-cup-of-zoo-preview",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "SITE_ENV": "staging",
    "CONTENT_MODE": "fixture"
  },
  "observability": {
    "enabled": true
  }
}
